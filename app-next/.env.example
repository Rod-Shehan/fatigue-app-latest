# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fatigue_app"

# NextAuth (required)
NEXTAUTH_SECRET="generate-a-long-random-string"
# Public URL of the app (must match your deployment, e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Production: field drivers must be on Approved Drivers (/drivers) with a matching email before they can sign in.
# Per-driver passwords are set when managers add/edit drivers; optional fleet shared password below.
# Required for seeded test users unless you set SEED_USER_PASSWORD when running prisma db seed.
NEXTAUTH_CREDENTIALS_PASSWORD=""

# Default: fleet shared password is tried before per-user bcrypt (option A). Set to "false" to enforce individual passwords first.
# NEXTAUTH_SHARED_PASSWORD_PRIORITY="false"

# Optional: when set, prisma db seed hashes this and stores it on seed users (bcrypt).
# Can match NEXTAUTH_CREDENTIALS_PASSWORD for convenience.
# SEED_USER_PASSWORD=""

# Organisation owner (IT / governance). Seeded on db seed; required for first owner claim in production.
# OWNER_SEED_EMAIL="owner@yourfleet.com.au"

# FRMS Python microservice (optional — default FRMS_ENGINE=legacy keeps TS risk register)
# Deploy frms-engine/ first — see frms-engine/README.md (Railway recommended)
# FRMS_ENGINE="hybrid"
# FRMS_PYTHON_URL="https://your-frms-service.up.railway.app"
# FRMS_PYTHON_API_KEY="same-secret-on-railway-and-vercel"
# FRMS_INTERNAL_SECRET="generate-a-long-random-string"

# --- Dev / staging only (remove before public launch) ---
# NEXTAUTH_ALLOW_DEV_LOGIN="true"
# NEXTAUTH_DEV_BYPASS_SECRET="generate-a-long-random-string-use-as-login-password"
# NEXT_PUBLIC_AUTH_DEV_LOGIN_HINT="true"
# On Vercel Preview, blank password also works (no passwordHash) when ALLOW_DEV_LOGIN=true.

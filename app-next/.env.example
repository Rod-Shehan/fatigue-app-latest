# Copy to .env.local for local development. On Vercel, set Production (and Preview) env in the dashboard — do not commit secrets.
#
# Auth, roles, passwords (production vs local): see docs/AUTH_AND_ROLES.md

# --- Required (all environments) ---
DATABASE_URL="postgresql://..."
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# Canonical site URL — production: https://www.circadia24.com
NEXTAUTH_URL="http://localhost:3000"

# --- Product surface (legacy | ewd | enterprise) ---
# Soft split across subdomains. Defaults to legacy (combined app).
# Prefer setting both; Host inference also works for legacy./ewd./enterprise. subdomains.
# APP_SURFACE=legacy
# NEXT_PUBLIC_APP_SURFACE=legacy
# Sibling URLs for cross-product redirects (optional until those hosts are live):
# NEXT_PUBLIC_LEGACY_APP_URL=https://legacy.circadia24.com
# NEXT_PUBLIC_EWD_APP_URL=https://ewd.circadia24.com
# NEXT_PUBLIC_ENTERPRISE_APP_URL=https://enterprise.circadia24.com

# --- Local dev only (never on production unless explicitly approved) ---
# Shared test password when drivers/managers have no per-user bcrypt hash
NEXTAUTH_CREDENTIALS_PASSWORD=""

# Staging bypass — blocked automatically when NODE_ENV=production
# NEXTAUTH_ALLOW_DEV_LOGIN=true
# NEXTAUTH_DEV_BYPASS_SECRET=""

# --- Production pilot (driver + manager week) ---
# Comma-separated emails allowed to sign in when set. Omit to allow all roster-valid users.
# CIRCADIA_ALPHA_ALLOWLIST="driver@example.com,manager@example.com"

# Shared fleet password on production (default: off — use per-user passwords from Approved Drivers)
# CIRCADIA_ALLOW_SHARED_LOGIN_PASSWORD=true

# First owner bootstrap (one-time)
# OWNER_SEED_EMAIL="owner@example.com"

# --- Integrations (optional) ---
# AUTONOMISE_WEBHOOK_SECRET=
# AUTONOMISE_BLOCK_BRIDGE_ENABLED=true

# Circadia Command triage — promote accepted Autonomise events into edge_fatigue_events (shared Neon)
# COMMAND_PILOT_TENANT_ID_UUID=00000000-0000-4000-8000-000000000001
# COMMAND_LIFECYCLE_BRIDGE_ENABLED=true
# COMMAND_APP_URL=https://command.circadia24.com
# TEST_INCIDENT_INTERNAL_SECRET=  # shared with circadia-command; also enables background push dispatch

# --- Neon direct URL (Command SSE / migrations / pg_dump) ---
# Prefer unpooled host (no "-pooler") for dumps and LISTEN/NOTIFY.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# --- Nightly DB backup → Cloudflare R2 (GitHub Actions secrets — NOT Vercel runtime) ---
# See docs/ops/db-backup-restore.md and docs/product/hot-cold-record-access-project-scope.md
# Repo → Settings → Secrets and variables → Actions:
#   DATABASE_URL_UNPOOLED
#   BACKUP_ENCRYPTION_KEY   # openssl rand -base64 48
#   R2_ACCOUNT_ID
#   R2_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY
#   R2_BUCKET_NAME          # dedicated bucket e.g. circadia-db-backups (not photo/evidence)

// Prisma schema – Driver Fatigue Log (no Base44)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  passwordHash  String?
  /** When an admin or the user last set the login password (plaintext is never stored). */
  passwordSetAt   DateTime?
  passwordSetById String?
  passwordSetBy   User?     @relation("UserPasswordSetBy", fields: [passwordSetById], references: [id], onDelete: SetNull)
  passwordsSetFor User[]    @relation("UserPasswordSetBy")
  /** driver (null) | manager | owner — owner is org/IT governance above fleet managers */
  role          String?
  /** When set, sign-in is blocked until cleared by an owner */
  disabledAt    DateTime?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  fatigueSheets FatigueSheet[]
  auditEvents   AuditEvent[]
  messageThreads MessageThread[]
  messagesSent   Message[]
  driverRiskBlocks DriverRiskBlock[]
  routePresetsCreated RoutePreset[]
  systemPoliciesUpdated SystemPolicy[]
}

/** Singleton org lockdown flags — owner-controlled (Phase A governance). */
model SystemPolicy {
  id                    String   @id @default("default")
  loginDisabled         Boolean  @default(false)
  driverWritesDisabled  Boolean  @default(false)
  managerWritesDisabled Boolean  @default(false)
  maintenanceMessage    String?
  updatedAt             DateTime @updatedAt
  updatedById           String?
  updatedBy               User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@id([identifier, token])
}

model Driver {
  id             String   @id @default(cuid())
  name           String
  email          String?  @unique
  licenceNumber  String?
  /** WA Commercial Driver's Medical certificate expiry — optional reminder only (S7). */
  cvdMedicalExpiry DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model TruckRego {
  id        String   @id @default(cuid())
  label     String   // e.g. "1ABC 234"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/** Shared run-plan catalogue — managers (fleet) and drivers can add entries (ADR 0003). */
model RoutePreset {
  id                 String   @id @default(cuid())
  label              String
  /** Where the run begins (day card "Start location"). */
  startLocation      String?
  /** Where the run ends (day card "Destination"). */
  destination        String?
  plannedDistanceKm  Float?
  plannedOnDutyHours Float?
  /** "fleet" = org catalogue (org_preset); "driver" = driver-added (driver_saved). */
  catalogueSource    String   @default("fleet")
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdById        String?
  createdBy          User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
}

model FatigueSheet {
  id              String    @id @default(cuid())
  /** Regulatory scope for this sheet (ADR 0001); only WA implemented today. */
  jurisdictionCode String   @default("WA_OSH_3132")
  driverName      String
  secondDriver    String?
  driverType      String    @default("solo") // "solo" | "two_up"
  destination     String?
  last24hBreak    String?   // YYYY-MM-DD date of last 24-hour break
  weekStarting    String    // YYYY-MM-DD
  days            String    // JSON array of 7 day objects
  status          String    @default("draft") // "draft" | "completed"
  signature       String?   // data URL
  signedAt        DateTime?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditEvents     AuditEvent[]
  messageThreads  MessageThread[]
}

model AuditEvent {
  id        String      @id @default(cuid())
  sheetId   String
  sheet     FatigueSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  payload   Json?
  createdAt DateTime    @default(now())

  @@index([sheetId, createdAt])
  @@index([actorId, createdAt])
}

model MessageThread {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sheetId     String?
  sheet       FatigueSheet? @relation(fields: [sheetId], references: [id], onDelete: SetNull)
  subject     String
  status      String   @default("open") // "open" | "closed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]

  @@index([createdById, updatedAt])
  @@index([sheetId, updatedAt])
  @@index([status, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([senderId, createdAt])
}

/** 15-minute fused risk blocks (camera BT stream + optional diary context). Assurance only — not compliance. */
model DriverRiskBlock {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverName    String
  blockStartMs  BigInt
  blockMinutes  Int      @default(15)
  timezone      String   @default("Australia/Perth")
  uploadId      String
  deviceId      String?
  packetVersion Int      @default(1)
  cameraPayload Json
  diaryContext  Json?
  baselinePct   Int
  livePct       Int
  fusionSources String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, uploadId])
  @@index([driverName, blockStartMs])
  @@index([userId, blockStartMs])
}

/// One FRMS computation for a driver + horizon (deduped by input hash).
model FrmsProfileRun {
  id                  String   @id @default(cuid())
  driverName          String
  userId              String?
  weekStarting        String?
  horizonFromMs       BigInt
  horizonToMs         BigInt
  timezone            String   @default("Australia/Perth")
  engineVersion       String
  modelVersion        String?
  inputHash           String
  status              String   @default("pending")
  errorMessage        String?
  sources             String[] @default([])
  prospectiveRegister Json?
  requestedAt         DateTime @default(now())
  completedAt         DateTime?
  snapshots           FrmsRiskSnapshot[]

  @@unique([driverName, inputHash, engineVersion])
  @@index([driverName, weekStarting, status])
  @@index([status, requestedAt])
}

/// 15-minute FRMS profile points (aligned with RISK_BLOCK_MINUTES).
model FrmsRiskSnapshot {
  id           String         @id @default(cuid())
  runId        String
  run          FrmsProfileRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  blockStartMs BigInt
  blockMinutes Int            @default(15)
  processSPct  Float?
  processCPct  Float?
  modelPct     Float?
  combinedPct  Int
  band         String?
  createdAt    DateTime       @default(now())

  @@unique([runId, blockStartMs])
  @@index([runId, blockStartMs])
}

/** Raw Autonomise Event / Media webhook capture (MTS pilot — maps to lifecycle later). */
model AutonomiseWebhookIngest {
  id             String   @id @default(cuid())
  kind           String   // event | media
  idempotencyKey String?
  vendorAlarmId  String?
  vendorEventId  String?
  vehicleRego    String?
  driverName     String?
  linkedEventId  String?
  mediaUrl       String?
  accepted       Boolean  @default(false)
  rejectReason   String?
  payload        Json
  receivedAt     DateTime @default(now())

  metricsAttribution AutonomiseMetricsAttribution?

  @@unique([kind, idempotencyKey])
  @@index([receivedAt])
  @@index([kind, accepted])
  @@index([vehicleRego, receivedAt])
}

/** Manual + sheet-duty attribution for Autonomise → risk block bridge (metrics only). */
model AutonomiseMetricsAttribution {
  ingestEventId     String   @id
  ingestEvent       AutonomiseWebhookIngest @relation(fields: [ingestEventId], references: [id], onDelete: Cascade)
  driverName        String
  source            String   // sheet_duty | manual
  blockStartMs      BigInt
  attributedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([driverName, blockStartMs])
  @@index([source])
}

/** Manager Authorize / Dismiss on camera fatigue events (audit trail). */
model CameraAlertTriage {
  id              String   @id @default(cuid())
  ingestEventId   String   @unique
  vendorEventId   String?
  decision        String   // authorized | dismissed
  note            String?
  decidedByUserId String
  decidedByEmail  String?
  decidedAt       DateTime @default(now())

  @@index([decidedAt])
  @@index([decision])
}

/** Manager-selected Autonomise alarm types for live alerts ingest + inbox (singleton). */
model CameraAlertEventSettings {
  id              String   @id @default("default")
  /** VT3600AI_ALARM_* ids from fatigue-event-catalogue (offered tiers only). */
  enabledAlarmIds Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

/** Triage desk shift — names and/or roles on duty (manager + Command §3.5). */
model TriageShift {
  id              String   @id @default(cuid())
  startsAt        DateTime @db.Timestamptz(6)
  endsAt          DateTime @db.Timestamptz(6)
  /** { userIds: string[], operatorIds: string[], roles: string[] } */
  assignees       Json
  handoffNote     String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([startsAt, endsAt])
}

/** Operational actions after verified fatigue — shared queue audit (§3.5.4). */
model IncidentActionLog {
  id              String    @id @default(cuid())
  lifecycleId     String?   @db.Uuid
  ingestEventId   String?
  actionType      String
  resolutionNotes String?
  actorType       String
  actorId         String
  actorLabel      String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([lifecycleId])
  @@index([ingestEventId])
  @@map("IncidentActionLog")
}

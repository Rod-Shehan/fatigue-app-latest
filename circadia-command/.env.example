# Neon Postgres (shared instance)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require"
# Direct (no -pooler) — required for SSE LISTEN/NOTIFY
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# WebAuthn + session (required in production)
COMMAND_SESSION_SECRET="generate-with-openssl-rand-base64-32"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3001"

# Dev: skip passkey on npm run dev (set false to test WebAuthn locally)
COMMAND_SKIP_WEBAUTHN="true"
NEXT_PUBLIC_COMMAND_SKIP_WEBAUTHN="true"

# Dev operator default email
COMMAND_DEV_OPERATOR_EMAIL="operator@circadia.local"
# Production emergency bypass only:
COMMAND_ALLOW_DEV_LOGIN="false"

# Pilot tenant UUID for simulate-ingest when no identity map exists
COMMAND_PILOT_TENANT_ID_UUID="00000000-0000-4000-8000-000000000001"

# Production only
COMMAND_OPERATOR_IP_WHITELIST="101.175.82.44"
COMMAND_ALLOW_DEV_LOGIN="false"
COMMAND_ALLOW_SIMULATE="false"

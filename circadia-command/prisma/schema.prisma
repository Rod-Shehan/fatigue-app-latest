// Circadia Command Center — isolated Prisma schema.
// Shares Neon Postgres with the customer app; no app-next models duplicated here.
// RLS on fatigue_incident_lifecycle is applied via prisma/sql/001_command_lifecycle.sql only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IdentityUuidMap {
  mappingId    String   @id @default(uuid()) @map("mapping_id") @db.Uuid
  tenantCuid   String   @map("tenant_cuid") @db.VarChar(30)
  tenantIdUuid String   @unique @map("tenant_id_uuid") @db.Uuid
  driverCuid   String   @unique @map("driver_cuid") @db.VarChar(30)
  driverIdUuid String   @unique @map("driver_id_uuid") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantCuid, driverCuid], map: "idx_uuid_map_lookup")
  @@map("identity_uuid_map")
}

model EdgeFatigueEvent {
  eventId            String   @id @default(uuid()) @map("event_id") @db.Uuid
  tenantIdUuid       String   @map("tenant_id_uuid") @db.Uuid
  driverIdUuid       String   @map("driver_id_uuid") @db.Uuid
  vehicleRegistration String  @map("vehicle_registration") @db.VarChar(20)
  hardwareTimestamp  DateTime @map("hardware_timestamp") @db.Timestamptz(6)
  speedKmh           Decimal  @map("speed_kmh") @db.Decimal(5, 2)
  headingDegrees     Int      @map("heading_degrees")
  laneDeviationIndex Decimal  @map("lane_deviation_index") @db.Decimal(3, 2)
  brakingPressurePsi Int      @default(0) @map("braking_pressure_psi")
  aiModelVersion     String   @map("ai_model_version") @db.VarChar(50)
  fatigueMetricType  String   @map("fatigue_metric_type") @db.VarChar(50)
  confidenceScore    Decimal  @map("confidence_score") @db.Decimal(3, 2)
  videoSnippetUrl    String   @map("video_snippet_url")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lifecycle FatigueIncidentLifecycle?

  @@index([driverIdUuid, hardwareTimestamp(sort: Desc)], map: "idx_edge_events_triage")
  @@map("edge_fatigue_events")
}

model CommandOperator {
  operatorId          String    @id @default(uuid()) @map("operator_id") @db.Uuid
  username            String?   @unique @db.VarChar(64)
  email               String?   @unique @db.VarChar(255)
  fullName            String    @map("full_name") @db.VarChar(255)
  role                String    @default("command_operator") @db.VarChar(32)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  passwordSetAt       DateTime? @map("password_set_at") @db.Timestamptz(6)
  isActive            Boolean   @default(true) @map("is_active")
  hardwareMfaVerified Boolean   @default(false) @map("hardware_mfa_verified")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  lifecycleEvents FatigueIncidentLifecycle[]
  passkeys          CommandOperatorPasskey[]

  @@map("command_operators")
}

model CommandOperatorPasskey {
  credentialId String          @id @map("credential_id")
  operatorId   String          @map("operator_id") @db.Uuid
  operator     CommandOperator @relation(fields: [operatorId], references: [operatorId], onDelete: Cascade)
  publicKey    Bytes           @map("public_key")
  counter      BigInt          @default(0)
  transports   String?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([operatorId], map: "idx_passkeys_operator")
  @@map("command_operator_passkeys")
}

model FatigueIncidentLifecycle {
  lifecycleId             String   @id @default(uuid()) @map("lifecycle_id") @db.Uuid
  eventId                 String   @unique @map("event_id") @db.Uuid
  event                   EdgeFatigueEvent @relation(fields: [eventId], references: [eventId])
  tenantIdUuid            String   @map("tenant_id_uuid") @db.Uuid
  driverIdUuid            String   @map("driver_id_uuid") @db.Uuid
  operatorId              String?  @map("operator_id") @db.Uuid
  operator                CommandOperator? @relation(fields: [operatorId], references: [operatorId], onDelete: SetNull)

  eventStatus             String   @map("event_status") @db.VarChar(50)
  operatorNotes           String?  @map("operator_notes")
  telemetrySnapshotJson   Json     @map("telemetry_snapshot_json")

  detectedAt              DateTime  @map("detected_at") @db.Timestamptz(6)
  triagedAt               DateTime? @map("triaged_at") @db.Timestamptz(6)
  interventionTriggeredAt DateTime? @map("intervention_triggered_at") @db.Timestamptz(6)
  driverRespondedAt       DateTime? @map("driver_responded_at") @db.Timestamptz(6)
  closedAt                DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  transitionLogs LifecycleTransitionLog[]

  @@index([eventStatus, detectedAt(sort: Desc)], map: "idx_lifecycle_perf")
  @@map("fatigue_incident_lifecycle")
}

model LifecycleTransitionLog {
  logId                       String   @id @default(uuid()) @map("log_id") @db.Uuid
  lifecycleId                 String   @map("lifecycle_id") @db.Uuid
  lifecycle                   FatigueIncidentLifecycle @relation(fields: [lifecycleId], references: [lifecycleId])
  fromStatus                  String   @map("from_status") @db.VarChar(50)
  toStatus                    String   @map("to_status") @db.VarChar(50)
  triggeredById               String   @map("triggered_by_id") @db.VarChar(255)
  actorType                   String   @map("actor_type") @db.VarChar(50)
  transitionTimestamp         DateTime @default(now()) @map("transition_timestamp") @db.Timestamptz(6)
  transitionPayloadSnapshot   Json     @map("transition_payload_snapshot")

  @@index([lifecycleId, transitionTimestamp(sort: Asc)], map: "idx_transition_audit_trail")
  @@map("lifecycle_transition_log")
}

model TenantCompliancePolicyOverride {
  policyId                      String   @id @default(uuid()) @map("policy_id") @db.Uuid
  tenantIdUuid                  String   @unique @map("tenant_id_uuid") @db.Uuid
  enforceManagerGate            Boolean  @default(false) @map("enforce_manager_gate")
  allowManagerOverrideDismissal Boolean  @default(true) @map("allow_manager_override_dismissal")
  updatedAt                     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_compliance_policy_overrides")
}
